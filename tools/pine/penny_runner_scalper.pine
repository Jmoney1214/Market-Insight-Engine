//@version=6
indicator("Penny Runner Scalper [Copilot]", overlay=true, max_labels_count=100)
// Intraday scalper for SUB-$10 LOW-FLOAT RUNNERS on seconds/1-min charts. NOT for
// liquid large-caps (use Trend Rider for those). Matches the KIDZ-type movement:
// vertical ignition -> blow-off top -> chop/fade below VWAP. It ONLY signals the
// ignition leg and LOCKS OUT during the below-VWAP whipsaw that shreds EMA/Donchian
// tools. No validated edge in this universe yet — paper-trade first.

// ---- Arm / regime: stay dark until the name is actually a runner ----
grpArm    = "Arm / regime"
minDayChg = input.float(20.0, "Arm only if day change % ≥", step=1.0, group=grpArm, tooltip="Stay dark until the stock is up this much on the day — i.e. it is a real runner.")
minPrice  = input.float(0.10, "Min price", step=0.01, group=grpArm)
maxPrice  = input.float(10.0, "Max price (this tool is for sub-$10)", step=0.5, group=grpArm)

// ---- Ignition long ----
grpIgn    = "Ignition long"
rvolLen   = input.int(20, "RVOL length (bars)", minval=2, group=grpIgn)
rvolSurge = input.float(3.0, "Volume surge — RVOL ≥", step=0.5, group=grpIgn)
brkLen    = input.int(20, "Breakout lookback (bars)", minval=2, group=grpIgn, tooltip="Ignition = a new high over this many prior bars.")

// ---- Stop / trail guide ----
grpStop   = "Stop / trail guide"
emaLen    = input.int(9, "Fast EMA (trail guide)", minval=1, group=grpStop)
atrLen    = input.int(14, "ATR length", minval=1, group=grpStop)
atrMult   = input.float(1.5, "Initial stop = ATR ×", step=0.1, group=grpStop)

// ---- Series ----
vwapV   = ta.vwap
emaF    = ta.ema(close, emaLen)
atrV    = ta.atr(atrLen)
avgVol  = ta.sma(volume, rvolLen)
rvol    = avgVol > 0 ? volume / avgVol : 0.0
// day change measured from the PRIOR daily close (includes the overnight gap — a
// +43% gapper is a runner even if it's only +15% from today's open). close[1] under
// lookahead_on pins to the last COMPLETED daily bar — leak-free, never drop the [1].
prevClose = request.security(syminfo.tickerid, "D", close[1], lookahead=barmerge.lookahead_on)
dayChg    = prevClose > 0 ? (close - prevClose) / prevClose * 100.0 : 0.0
armed   = dayChg >= minDayChg and close >= minPrice and close <= maxPrice
aboveV  = close > vwapV

// ---- Signals ----
priorHigh = ta.highest(high, brkLen)[1]                       // prior N-bar high (no look-ahead)
igniteRaw = armed and aboveV and rvol >= rvolSurge and high > priorHigh
ignite    = igniteRaw and not igniteRaw[1]                     // fire once per ignition, not every bar

standAside = armed and (not aboveV or rvol < 1.0)             // below VWAP or volume dying = whipsaw zone

igniteStop = math.min(low, close - atrMult * atrV)

state = not armed ? "OFF (not a runner)" : ignite ? "IGNITE ▲" : standAside ? "CHOP — stand aside" : aboveV ? "READY (above VWAP)" : "watch"

// ---- Plots ----
plot(vwapV, "VWAP", color=color.new(color.blue, 0), linewidth=2)
plot(emaF, "Fast EMA", color=color.new(color.orange, 0))
bgcolor(standAside ? color.new(color.gray, 88) : na, title="Stand-aside (chop)")
plotshape(ignite, "Ignition long", shape.triangleup, location.belowbar, color.new(color.green, 0), text="IGNITE", textcolor=color.white, size=size.small)

if ignite
    label.new(bar_index, low, "IGNITE " + str.tostring(close, format.mintick) + "  stop " + str.tostring(igniteStop, format.mintick), yloc=yloc.belowbar, style=label.style_label_up, color=color.new(color.green, 0), textcolor=color.white, size=size.small)

// ---- Status table ----
var table t = table.new(position.top_right, 2, 5, border_width=1)
if barstate.islast
    bg = not armed ? color.new(color.gray, 0) : ignite ? color.new(color.green, 0) : standAside ? color.new(color.orange, 0) : color.new(color.teal, 0)
    blk = color.new(color.black, 0)
    table.cell(t, 0, 0, "Penny Runner", text_color=color.white, bgcolor=blk)
    table.cell(t, 1, 0, state, text_color=color.white, bgcolor=bg)
    table.cell(t, 0, 1, "Day chg", text_color=color.white, bgcolor=blk)
    table.cell(t, 1, 1, str.tostring(dayChg, "#.#") + "%", text_color=color.white, bgcolor=blk)
    table.cell(t, 0, 2, "RVOL", text_color=color.white, bgcolor=blk)
    table.cell(t, 1, 2, str.tostring(rvol, "#.#") + "x", text_color=color.white, bgcolor=blk)
    table.cell(t, 0, 3, "VWAP", text_color=color.white, bgcolor=blk)
    table.cell(t, 1, 3, (aboveV ? "above +" : "below ") + str.tostring((close - vwapV) / vwapV * 100.0, "#.#") + "%", text_color=color.white, bgcolor=blk)
    table.cell(t, 0, 4, "Price", text_color=color.white, bgcolor=blk)
    table.cell(t, 1, 4, str.tostring(close, format.mintick), text_color=color.white, bgcolor=blk)

// ---- Alerts (native TradingView chart alerts) ----
alertcondition(ignite, "Penny Runner — IGNITION LONG", "IGNITE long — new high + RVOL surge above VWAP on a runner")
if ignite
    alert("IGNITE LONG " + syminfo.ticker + " @ " + str.tostring(close, format.mintick) + " · RVOL " + str.tostring(rvol, "#.#") + "x · stop " + str.tostring(igniteStop, format.mintick), alert.freq_once_per_bar_close)

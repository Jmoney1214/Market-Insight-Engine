<?xml version="1.0" encoding="UTF-8"?>
<!-- FinDesk api-server launchd agent (template).
     __REPO__ is substituted by install.sh with the absolute repo path;
     __HOME__ with the operator's home directory. launchd plists cannot
     expand environment variables, so the installer bakes real paths in. -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.findesk.api-server</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>__REPO__/ops/launchd/run_server.sh</string>
  </array>

  <!-- Start at login/boot, restart on ANY exit (crash or clean). -->
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <!-- Back off 15s between restarts so a hard-broken build can't spin-loop. -->
  <key>ThrottleInterval</key>
  <integer>15</integer>

  <key>WorkingDirectory</key>
  <string>__REPO__</string>

  <key>StandardOutPath</key>
  <string>__HOME__/Library/Logs/findesk/api-server.out.log</string>
  <key>StandardErrorPath</key>
  <string>__HOME__/Library/Logs/findesk/api-server.err.log</string>

  <!-- The scan scheduler is time-of-day aware; nothing else to configure. -->
</dict>
</plist>
